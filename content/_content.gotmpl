{{/*
  Verdeelt de foto's uit de map images/ over de albums en maakt voor elk
  werk een eigen pagina met informatie over het werk.

  De eerste letter van de bestandsnaam bepaalt het album:
    K = Koppen, P = Penningen, B = Buste, L = Lichamen, H = Handen, O = Overig
  Bestanden met een andere eerste letter worden overgeslagen (met een waarschuwing).

  Een werk kan meerdere foto's hebben: dezelfde naam met een volgnummer aan het
  eind (1 of 2 cijfers na - of _), bijvoorbeeld K_portret-1.jpg, K_portret-2.jpg.
  Foto 1 (of anders het laagste nummer) is de hoofdfoto: alleen die verschijnt
  in de overzichten; de werkpagina toont ze allemaal. Een naam zonder nummer is
  een werk met één foto.

  Informatie over een werk staat in een .yaml-bestand met de naam van het werk
  zonder nummer (bijvoorbeeld K_portret.yaml). Zie images/README.md.
*/}}
{{ $albums := dict "k" "koppen" "p" "penningen" "b" "buste" "l" "lichamen" "h" "handen" "o" "overig" }}

{{/* 1. Foto's per werk verzamelen */}}
{{ $werken := newScratch }}
{{ range resources.Match "images/*" }}
  {{ if eq .MediaType.MainType "image" }}
    {{ $name := path.Base .Name }}
    {{ $album := index $albums (substr $name 0 1 | lower) }}
    {{ if $album }}
      {{ $stam := strings.TrimSuffix (path.Ext $name) $name }}
      {{ $base := $stam }}
      {{ $nummer := 1 }}
      {{ with index (findRESubmatch `^(.+?)[-_](\d{1,2})$` $stam 1) 0 }}
        {{ $base = index . 1 }}
        {{ $nummer = int (strings.TrimLeft "0" (index . 2) | default "0") }}
      {{ end }}
      {{ $key := printf "%s/%s" $album $base }}
      {{ $werken.Add $key (slice (dict "nummer" $nummer "naam" $name "foto" . "album" $album "base" $base)) }}
    {{ else }}
      {{ warnf "images/%s: bestandsnaam begint niet met K, P, B, L, H of O; foto wordt overgeslagen" $name }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* 2. Per werk: hoofdfoto in het album, pagina met alle foto's */}}
{{ range $key, $fotos := $werken.Values }}
  {{ $fotos = sort $fotos "nummer" }}
  {{ $hoofd := index $fotos 0 }}
  {{ $album := $hoofd.album }}
  {{ $base := $hoofd.base }}
  {{ $slug := $base | urlize | lower }}

  {{ $info := dict }}
  {{ $heeftInfo := false }}
  {{ with resources.Get (printf "images/%s.yaml" $base) }}
    {{ $info = . | transform.Unmarshal | default dict }}
    {{ $heeftInfo = true }}
  {{ end }}

  {{/* Techniek en materiaal worden ook filters (taxonomieën): tekst of lijst */}}
  {{ $technieken := slice }}
  {{ with $info.techniek }}{{ $technieken = cond (reflect.IsSlice .) . (slice .) }}{{ end }}
  {{ $materialen := slice }}
  {{ with $info.materiaal }}{{ $materialen = cond (reflect.IsSlice .) . (slice .) }}{{ end }}

  {{/* Zonder titel: maak er een van de bestandsnaam, "K_oude-man" -> "Oude man" */}}
  {{ $title := $info.titel | default ($base | replaceRE `^[a-zA-Z][-_ ]*` "" | replaceRE `[-_]+` " " | strings.FirstUpper) }}

  {{/* Alleen de hoofdfoto in het album; params.werk verwijst naar de pagina van het werk */}}
  {{ $.AddResource (dict
    "path" (printf "%s/%s" $album $hoofd.naam)
    "content" (dict "value" $hoofd.foto)
    "title" $title
    "params" (dict "werk" $slug)
  ) }}

  {{ $namen := slice }}
  {{ range $fotos }}{{ $namen = $namen | append .naam }}{{ end }}
  {{ $.AddPage (dict
    "path" (printf "%s/%s" $album $slug)
    "title" $title
    "kind" "page"
    "layout" "werk"
    "params" (merge $info (dict "afbeelding" $hoofd.naam "afbeeldingen" $namen "bestand" $base "heeft_info" $heeftInfo "technieken" $technieken "materialen" $materialen))
    "build" (dict "list" "always")
  ) }}
  {{ range $fotos }}
    {{ $.AddResource (dict
      "path" (printf "%s/%s/%s" $album $slug .naam)
      "content" (dict "value" .foto)
      "title" $title
    ) }}
  {{ end }}
{{ end }}
